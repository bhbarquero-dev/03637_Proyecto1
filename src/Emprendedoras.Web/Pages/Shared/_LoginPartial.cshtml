@using Microsoft.AspNetCore.Identity
@using Emprendedoras.Web.Data
@inject SignInManager<IdentityUser> SignInManager

@if (SignInManager.IsSignedIn(User))
{
    <ul class="navbar-nav">
        @if (User.IsInRole(CuentaAdministracion.Rol))
        {
            <li class="nav-item">
                <a class="nav-link text-dark" asp-area="" asp-page="/Admin/Index">Solicitudes recibidas</a>
            </li>
        }
        <li class="nav-item">
            <form asp-area="" asp-page="/Cuenta/Salir" method="post">
                <button type="submit" class="nav-link btn btn-link text-dark">Cerrar sesión</button>
            </form>
        </li>
    </ul>
}
