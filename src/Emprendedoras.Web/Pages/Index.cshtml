@page
@model IndexModel
@{
    ViewData["Title"] = "Catálogo de productos";
}

<h1 class="h2 mb-3">Catálogo de productos</h1>
<p class="mb-4">Productos elaborados por las emprendedoras de la asociación.</p>

@if (Model.Productos.Count == 0)
{
    <p>Por ahora no hay productos en el catálogo.</p>
}
else
{
    <ul class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4 list-unstyled" aria-label="Productos">
        @foreach (var producto in Model.Productos)
        {
            <li class="col">
                <article class="card h-100 producto" aria-labelledby="producto-@producto.Id">
                    <img src="@producto.ImagenUrl" alt="@producto.ImagenAlt" width="400" height="300"
                         class="card-img-top producto-imagen" loading="lazy" decoding="async" />
                    <div class="card-body d-flex flex-column">
                        <h2 id="producto-@producto.Id" class="h5 card-title">@producto.Nombre</h2>
                        <p class="card-text">@producto.Descripcion</p>
                        <dl class="producto-datos mb-0 mt-auto">
                            <dt>Precio</dt>
                            <dd class="fs-5 fw-bold">@IndexModel.FormatearPrecio(producto.Precio)</dd>
                            <dt>Emprendedora</dt>
                            <dd>@producto.Emprendedora</dd>
                            <dt>Disponibilidad</dt>
                            <dd>
                                @if (producto.Disponible)
                                {
                                    <span class="badge text-bg-success disponibilidad">Disponible</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary disponibilidad">Agotado</span>
                                }
                            </dd>
                        </dl>
                        @if (producto.Disponible)
                        {
                            <a class="btn btn-primary mt-3" asp-page="/Solicitudes/Nueva" asp-route-productoId="@producto.Id">
                                Solicitar<span class="visually-hidden"> @producto.Nombre</span>
                            </a>
                        }
                    </div>
                </article>
            </li>
        }
    </ul>
}
